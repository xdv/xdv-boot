// Description:
//   XDV-Boot canonical boot.bin flow for xdv-os:
//   splash -> wait 8 seconds -> recognize MBR/UEFI origin -> load /console/kernel.bin -> handoff

forge XdvBoot {

    const BOOT_OK: UInt32 = 0;
    const BOOT_FAIL: UInt32 = 1;

    const BOOT_DEVICE: UInt32 = 1;
    const SPLASH_SECONDS: UInt32 = 8;
    const MODE_DETECT_DEPTH: UInt32 = 2;

    const BOOT_MODE_UNKNOWN: UInt32 = 0;
    const BOOT_MODE_MBR: UInt32 = 1;
    const BOOT_MODE_UEFI: UInt32 = 2;

    const ERR_SPLASH_RENDER: UInt32 = 10;
    const ERR_SPLASH_TIMER: UInt32 = 11;
    const ERR_MODE_DETECT: UInt32 = 12;
    const ERR_MODE_PARITY: UInt32 = 13;
    const ERR_XDVFS_MOUNT: UInt32 = 14;
    const ERR_KERNEL_LOOKUP: UInt32 = 15;
    const ERR_KERNEL_LOAD: UInt32 = 16;
    const ERR_KERNEL_HANDOFF_PRECHECK: UInt32 = 17;
    const ERR_KERNEL_HANDOFF_TRANSFER: UInt32 = 18;

    proc K::boot_main() -> UInt32 {
        emit "xdv-boot: boot sequence start";

        let splash = boot_render_splash_step();
        if splash == BOOT_OK {
            let wait_status = boot_wait_splash_window();
            if wait_status == BOOT_OK {
                let mode = boot_probe_firmware_origin();
                if mode == BOOT_MODE_UNKNOWN {
                    return boot_fail(ERR_MODE_DETECT);
                } else {
                    let parity = boot_verify_firmware_path(mode);
                    if parity == BOOT_OK {
                        let loaded = boot_locate_and_load_kernel(mode);
                        if loaded == BOOT_OK {
                            let handoff = boot_kernel_handoff();
                            if handoff == BOOT_OK {
                                return BOOT_OK;
                            } else {
                                return handoff;
                            }
                        } else {
                            return loaded;
                        }
                    } else {
                        return boot_fail(ERR_MODE_PARITY);
                    }
                }
            } else {
                return boot_fail(ERR_SPLASH_TIMER);
            }
        } else {
            return boot_fail(ERR_SPLASH_RENDER);
        }
    }

    proc K::boot_fail(code: UInt32) -> UInt32 {
        if code == ERR_SPLASH_RENDER {
            emit "xdv-boot: failure: splash render step failed";
        } else {
            if code == ERR_SPLASH_TIMER {
                emit "xdv-boot: failure: splash timer step failed";
            } else {
                if code == ERR_MODE_DETECT {
                    emit "xdv-boot: failure: firmware origin detect failed";
                } else {
                    if code == ERR_MODE_PARITY {
                        emit "xdv-boot: failure: firmware parity verification failed";
                    } else {
                        if code == ERR_XDVFS_MOUNT {
                            emit "xdv-boot: failure: xdvfs mount failed";
                        } else {
                            if code == ERR_KERNEL_LOOKUP {
                                emit "xdv-boot: failure: /console/kernel.bin lookup failed";
                            } else {
                                if code == ERR_KERNEL_LOAD {
                                    emit "xdv-boot: failure: kernel load failed";
                                } else {
                                    if code == ERR_KERNEL_HANDOFF_PRECHECK {
                                        emit "xdv-boot: failure: strict handoff precheck failed";
                                    } else {
                                        if code == ERR_KERNEL_HANDOFF_TRANSFER {
                                            emit "xdv-boot: failure: kernel transfer routine failed";
                                        } else {
                                            emit "xdv-boot: failure: unspecified boot error";
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return code;
    }

    proc K::boot_render_splash_step() -> UInt32 {
        emit "xdv-boot: rendering splash";
        let splash = boot_splash_contract();
        if splash == BOOT_OK {
            emit "xdv-boot: splash render complete";
            return BOOT_OK;
        } else {
            return BOOT_FAIL;
        }
    }

    proc K::boot_wait_splash_window() -> UInt32 {
        emit "xdv-boot: starting splash timer window";
        let status = xdv_boot_prepare(SPLASH_SECONDS);
        if status == BOOT_OK {
            emit "xdv-boot: splash timer window complete";
            return BOOT_OK;
        } else {
            return BOOT_FAIL;
        }
    }

    proc K::boot_probe_firmware_origin() -> UInt32 {
        let mode = boot_loader_detect_mode(MODE_DETECT_DEPTH);
        if mode == BOOT_MODE_UEFI {
            emit "xdv-boot: boot.bin origin recognized as UEFI";
            return BOOT_MODE_UEFI;
        } else {
            if mode == BOOT_MODE_MBR {
                emit "xdv-boot: boot.bin origin recognized as MBR";
                return BOOT_MODE_MBR;
            } else {
                emit "xdv-boot: failure: boot.bin origin unresolved";
                return BOOT_MODE_UNKNOWN;
            }
        }
    }

    proc K::boot_verify_firmware_path(mode: UInt32) -> UInt32 {
        if mode == BOOT_MODE_MBR {
            let mbr = mbr_init();
            if mbr == BOOT_MODE_MBR {
                emit "xdv-boot: MBR parity check passed";
                return BOOT_OK;
            } else {
                emit "xdv-boot: failure: MBR parity check failed";
                return BOOT_FAIL;
            }
        } else {
            if mode == BOOT_MODE_UEFI {
                let uefi = uefi_stage_init();
                if uefi == BOOT_MODE_UEFI {
                    emit "xdv-boot: UEFI parity check passed";
                    return BOOT_OK;
                } else {
                    emit "xdv-boot: failure: UEFI parity check failed";
                    return BOOT_FAIL;
                }
            } else {
                emit "xdv-boot: failure: unsupported mode for parity check";
                return BOOT_FAIL;
            }
        }
    }

    proc K::boot_locate_and_load_kernel(mode: UInt32) -> UInt32 {
        if mode == BOOT_MODE_UEFI {
            emit "xdv-boot: UEFI mode confirmed; kernel lookup target xdvfs:/console/kernel.bin";
        } else {
            emit "xdv-boot: MBR mode confirmed; kernel lookup target xdvfs:/console/kernel.bin";
        }
        return boot_load_console_kernel();
    }

    proc K::boot_load_console_kernel() -> UInt32 {
        emit "xdv-boot: mounting xdvfs boot partition";
        let mounted = xdvfs_mount_device(BOOT_DEVICE);
        if mounted == BOOT_OK {
            let kernel_lba = xdvfs_get_console_kernel_lba();
            if kernel_lba > 0 {
                emit "xdv-boot: loading kernel from xdvfs:/console/kernel.bin";
                let load = kernel_load_from_lba(kernel_lba);
                if load == BOOT_OK {
                    emit "xdv-boot: kernel image load complete";
                    return BOOT_OK;
                } else {
                    return boot_fail(ERR_KERNEL_LOAD);
                }
            } else {
                return boot_fail(ERR_KERNEL_LOOKUP);
            }
        } else {
            return boot_fail(ERR_XDVFS_MOUNT);
        }
    }

    proc K::boot_kernel_handoff() -> UInt32 {
        let entry = kernel_get_entry();
        if entry > 0 {
            let strict = kernel_jump_to_entry();
            if strict == BOOT_OK {
                emit "xdv-boot: strict handoff to kernel entry only";
                let transfer = xdv_boot_transfer_kernel();
                if transfer == BOOT_OK {
                    return BOOT_OK;
                } else {
                    return boot_fail(ERR_KERNEL_HANDOFF_TRANSFER);
                }
            } else {
                return boot_fail(ERR_KERNEL_HANDOFF_PRECHECK);
            }
        } else {
            return boot_fail(ERR_KERNEL_HANDOFF_PRECHECK);
        }
    }
}