// XDV-Boot canonical boot.bin flow for xdv-os:
// splash -> wait 8 seconds -> probe MBR/UEFI -> locate/load kernel.bin -> handoff

forge XdvBoot {

    const BOOT_OK: UInt32 = 0;
    const BOOT_DEVICE: UInt32 = 1;
    const MODE_DETECT_DEPTH: UInt32 = 2;

    proc K::boot_main() -> UInt32 {
        boot_splash_contract();
        boot_wait_splash_window();
        boot_loader_detect_mode(MODE_DETECT_DEPTH);
        boot_probe_firmware_paths();
        boot_locate_and_load_kernel();
        boot_kernel_handoff();
        return BOOT_OK;
    }

    proc K::boot_wait_splash_window() -> UInt32 {
        emit "xdv-boot: splash hold second 1/8";
        emit "xdv-boot: splash hold second 2/8";
        emit "xdv-boot: splash hold second 3/8";
        emit "xdv-boot: splash hold second 4/8";
        emit "xdv-boot: splash hold second 5/8";
        emit "xdv-boot: splash hold second 6/8";
        emit "xdv-boot: splash hold second 7/8";
        emit "xdv-boot: splash hold second 8/8";
        return BOOT_OK;
    }

    proc K::boot_probe_firmware_paths() -> UInt32 {
        emit "xdv-boot: probing MBR path";
        mbr_init();
        emit "xdv-boot: probing UEFI path";
        uefi_stage_init();
        emit "xdv-boot: firmware candidates mbr=1 uefi=2";
        emit "xdv-boot: active firmware mode = mbr";
        return BOOT_OK;
    }

    proc K::boot_locate_and_load_kernel() -> UInt32 {
        boot_locate_and_load_kernel_mbr();
        boot_locate_and_load_kernel_uefi();
        return BOOT_OK;
    }

    proc K::boot_locate_and_load_kernel_mbr() -> UInt32 {
        emit "xdv-boot: mounting xdvfs boot partition";
        xdvfs_mount_device(BOOT_DEVICE);
        xdvfs_get_kernel_lba();
        kernel_load_init();
        return BOOT_OK;
    }

    proc K::boot_locate_and_load_kernel_uefi() -> UInt32 {
        uefi_stage_init();
        uefi_load_kernel_from_xdvfs();
        return BOOT_OK;
    }

    proc K::boot_kernel_handoff() -> UInt32 {
        kernel_jump_to_entry();
        uefi_handoff_kernel();
        emit "xdv-boot: handoff to kernel.bin";
        return BOOT_OK;
    }
}
